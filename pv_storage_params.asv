%% ===================================================================
%  pv_storage_params.ms
%  Central parameter file for Fig 12.18 PV + Battery Storage + VSI +
%  Grid Simulink/Simscape Electrical model.
% ===================================================================

clear; clc;

%% --- Grid ---------------------------------------------------------
f_grid      = 50;              % [Hz] grid frequency
w_grid      = 2*pi*f_grid;     % [rad/s]
Vgrid_LL_rms = 11e3;            % [V] grid line-line RMS voltage (at HV side of transformer)

%% --- Transformer ----------------------------------------------------
Xfmr_S_rated   = 150e3;         % [VA] transformer rating
Xfmr_V1_LL     = 380;           % [V] LV side line-line RMS (VSI side)
Xfmr_V2_LL     = 11e3;          % [V] HV side line-line RMS (grid side)
Xfmr_R1_pu     = 0.01;          % primary winding resistance (pu)
Xfmr_L1_pu     = 0.03;          % primary winding leakage inductance (pu)
Xfmr_R2_pu     = 0.01;          % secondary winding resistance (pu)
Xfmr_L2_pu     = 0.03;          % secondary winding leakage inductance (pu)
Xfmr_Rm_pu     = 500;           % magnetizing resistance (pu)
Xfmr_Lm_pu     = 500;           % magnetizing inductance (pu)
PV_Ns_series_cells = 1000;   % series cells per string (sets Voc_string)
PV_Np_parallel_str = 32;     % parallel strings (sets array current/power)
R_test_load = 480^2 / 30000;   % ≈ 4.6 Ohm — sized for ~50kW draw near Vmp
R_test_load_batt = 450^2 / 10000;   % ≈16 Ohm, targets ~10kW test draw
%% --- Feeder / line impedance (Rs1, Ls1) ----------------------------
Rs1 = 0.1;                      % [Ohm]
Ls1 = 1e-3;                     % [H]

%% --- VSI AC side ----------------------------------------------------
Vs1_LL_rms   = Xfmr_V1_LL;      % [V] VSI-side line-line RMS target
Vdc_ref      = 700;             % [V] DC bus voltage setpoint (VSI regulates this)
f_sw_VSI     = 5e3;             % [Hz] VSI switching frequency
Cdc          = 8000e-6;         % [F] DC bus capacitance

%% --- Local load (LOAD block: Cd1, Po1/Qo1, RL1) --------------------
Load_Po1 = 50e3;                % [W]   constant-power load real power
Load_Qo1 = 10e3;                % [VAR] constant-power load reactive power
RL1_P    = 20e3;                % [W]   parallel resistive load (at Vs1_LL_rms)
Cd1      = 50e-6;               % [F]   DC-link/filter cap at load front-end (if modeled)

%% --- PV Array -------------------------------------------------------
PV_rated_power_STC = 100e3;     % [W] total array rating at STC
PV_irradiance_STC  = 1000;      % [W/m^2]
PV_temp_STC        = 25;        % [degC]
PV_Voc_string      = 600;       % [V] open-circuit voltage per string (approx)
PV_Vmp_string      = 480;       % [V] max-power voltage per string (approx)

%% --- Boost converter (PV side, MPPT) --------------------------------
L1_boost   = 3e-3;              % [H]
R1_boost   = 0.01;              % [Ohm] parasitic series resistance
C_pv       = 100e-6;            % [F] PV-side smoothing cap (Cpv)
f_sw_boost = 8e3;               % [Hz]

%% --- Battery ----------------------------------------------------------
Batt_Vnom      = 400;           % [V] nominal battery voltage
Batt_AhRated   = 100;           % [Ah]
Batt_SOC_init  = 60;            % [%] initial state of charge
Batt_Charge_init = Batt_AhRated * Batt_SOC_init / 100;   % [Ah] initial charge, from SOC%
Batt_V1_calib = 11.5 * (Batt_Vnom / 12);     % scaled calibration voltage point
Batt_AH1_calib = 25;                          % this one can stay as-is (Ah, not voltage-dependent)
%% --- Bidirectional buck-boost converter (battery side) ---------------
L2_buckboost = 2e-3;            % [H]
R2_buckboost = 0.01;            % [Ohm]
C_b          = 100e-6;          % [F] battery-side smoothing cap (Cb)
f_sw_bb      = 8e3;             % [Hz]

%% --- Simulation / solver settings ------------------------------------
Ts_power   = 2e-6;              % [s] discrete solver step, powergui (Specialized Power Systems)
Ts_control = 150e-6;   % slightly longer than switching period (125us), avoids intra-cycle ripple sampling           % [s] control loop sample time (if discretized separately)
Tsim       = 2;                 % [s] default simulation stop time for skeleton tests

%% --- Save to base workspace note --------------------------------------
fprintf('Parameters loaded into base workspace.\n');
fprintf('Vdc_ref = %d V | Vgrid_LL = %.0f V | f_grid = %d Hz\n', ...
    Vdc_ref, Vgrid_LL_rms, f_grid);